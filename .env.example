# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STAKE_API_KEY: Optional Stake.com API Key for direct account & live markets syncing
STAKE_API_KEY=""

# THE_ODDS_API_KEY: Optional The-Odds-API key (500 free requests/month at the-odds-api.com)
# Provides real-time Pinnacle, Betfair & Bet365 multi-bookmaker benchmark odds and CLV detection.
THE_ODDS_API_KEY=""

# FOOTBALL_DATA_API_KEY: Optional Football-Data.org API key (Free tier at football-data.org)
# Provides official European league standings, recent form streaks & historical H2H matches.
FOOTBALL_DATA_API_KEY=""

# RAPIDAPI_KEY: Optional RapidAPI key for API-Football (Free tier on RapidAPI)
# Provides confirmed starting XI lineups, injury reports and player absences.
RAPIDAPI_KEY=""

# API_SPORTS_KEY: Optional direct API-Sports Key (api-sports.io) for worldwide 24/7 in-play real match events & live scores
API_SPORTS_KEY=""

# LICENSE_SECRET_KEY: Optional secret passphrase used to cryptographically sign VIP license keys (HMAC SHA-256)
LICENSE_SECRET_KEY=""

# ADMIN_MASTER_KEY: Optional master administrator key for generating VIP licenses from the backend
ADMIN_MASTER_KEY=""
